# If you don't have environment variables, uncomment the following line to skip validation:
# SKIP_ENV_VALIDATION=true



# --- DATABASE URL ---

# You may be given multiple database URLs. Add them all to this file, and
# prefix each with "DATABASE_URL=". Ensure only one is uncommented at a time.

# Shared Development Branch:
# DATABASE_URL=

# Personal Branch:
DATABASE_URL=



# --- ACCOUNT AUTHENTICATION ---

# Base URL used by Better Auth. Account auth is only possible from this URL.
BETTER_AUTH_URL="http://localhost:3000"
# Generate a random string with at least 32 characters by running this in
# your terminal: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional client IDs and secrets for signing in with these supported social
# providers. For example, to generate credentials for Google, follow step 1
# on this page: https://better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=



# --- NEBULA API ---

NEBULA_API_URL="https://api.utdnebula.com"
NEBULA_API_STORAGE_BUCKET="jupiter"
NEBULA_API_KEY=
NEBULA_API_STORAGE_KEY=
NEBULA_API_EMAIL_KEY=



# --- FEATURE FLAGS ---

# Vercel OpenID Connect credentials for accessing Vercel Flags
VERCEL_OIDC_TOKEN=
FLAGS_SECRET=
# To log where feature flags are resolved from, uncomment the following line:
# LOG_FLAG_ORIGINS=true

# For descriptions on each of the following flags, see `src/lib/utils/flags.ts`
# FLAG_EMAIL_AUTH=true
# FLAG_STRICT_PASSWORD_REQUIREMENTS=true
# FLAG_LOGIN_BANNER_TEXT=



# --- OPTIONAL ---

# JSON object for Google Gemini authentication (for AI features)
GEMINI_SERVICE_ACCOUNT=

# License key to remove banner for paid Syncfusion components
NEXT_PUBLIC_SYNCFUSION_LICENSE_KEY=

# Endpoint URL that the client sends data to. To preview Sentry's "Report a Bug"
# button, set to: "https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN=

# Connect to oAuth proxy on prod. Useful when port forwarding
OAUTH_PROXY_SECRET=

# Additional whitelisted URLS for BetterAuth. Useful when port forwarding
# Either a string or an array of valid URLs
# e.g. ["https://*.devtunnels.ms"]
AUTH_TRUSTED_ORIGINS=
